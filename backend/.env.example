# Copy this file to .env and edit
FLASK_ENV=development
# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173
# Where the SQLite file lives. On Render, point this at the persistent disk, e.g. /var/data/cybershield.db
DATABASE_PATH=database/cybershield.db
RATE_LIMIT=60 per minute
